[Unit]
Description=paneld, a generic touch panel
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/paneld -c /etc/paneld/paneld.conf
Restart=on-failure
RestartSec=5s

# Device access: DRM/KMS needs `video`, evdev needs `input`.
# Give paneld its own system user, in both groups.
User=paneld
Group=paneld
SupplementaryGroups=video input

# Writable state (atomic JSON writes per ADR 0014) and ctl socket.
RuntimeDirectory=paneld
StateDirectory=paneld
ConfigurationDirectory=paneld
Environment=PANELD_SOCK=/run/paneld/paneld.sock

# Harden what the daemon can see: it reads only its config directory
# and writes only its state / runtime directories.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadOnlyPaths=/etc/paneld
ReadWritePaths=/var/lib/paneld /run/paneld
# Devices the daemon needs. The service user must be in `video` /
# `input` for these to be useful even with DeviceAllow in place.
DeviceAllow=/dev/dri/card0 rwm
DeviceAllow=/dev/dri/card1 rwm
DeviceAllow=/dev/fb0 rwm
DeviceAllow=/dev/input/event0 rwm
DeviceAllow=/dev/input/event1 rwm
DeviceAllow=/dev/input/event2 rwm

[Install]
WantedBy=multi-user.target
