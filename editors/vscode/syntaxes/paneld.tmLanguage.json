{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "paneld",
  "scopeName": "source.paneld",
  "fileTypes": [
    "conf"
  ],
  "patterns": [
    {
      "include": "#body"
    }
  ],
  "repository": {
    "body": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#continuation"
        },
        {
          "include": "#variable-definition"
        },
        {
          "include": "#include"
        },
        {
          "include": "#param"
        },
        {
          "include": "#repeat"
        },
        {
          "include": "#style-header"
        },
        {
          "include": "#block-header"
        },
        {
          "include": "#assignment"
        },
        {
          "include": "#expression"
        },
        {
          "match": "\\{",
          "name": "punctuation.section.block.begin.paneld"
        },
        {
          "match": "\\}",
          "name": "punctuation.section.block.end.paneld"
        },
        {
          "match": ";",
          "name": "punctuation.separator.paneld"
        }
      ]
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.paneld"
    },
    "continuation": {
      "match": "\\\\$",
      "name": "constant.character.escape.line-continuation.paneld"
    },
    "variable-definition": {
      "begin": "(?:^|(?<=[{;]))\\s*(\\$[A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
      "beginCaptures": {
        "1": {
          "name": "variable.other.constant.paneld"
        },
        "2": {
          "name": "keyword.operator.assignment.paneld"
        }
      },
      "end": "(?=[;}])|(?<!\\\\)(?=\\n)",
      "name": "meta.variable.definition.paneld",
      "patterns": [
        {
          "include": "#value-start"
        },
        {
          "include": "#value"
        }
      ]
    },
    "include": {
      "begin": "(?:^|(?<=[{;]))\\s*(include)\\s*(=)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.paneld"
        },
        "2": {
          "name": "keyword.operator.assignment.paneld"
        }
      },
      "end": "(?=[;}])|(?<!\\\\)(?=\\n)",
      "contentName": "string.unquoted.path.paneld",
      "patterns": [
        {
          "include": "#value-comment"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "param": {
      "begin": "\\b(param)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.param.paneld"
        },
        "2": {
          "name": "variable.parameter.paneld"
        },
        "3": {
          "name": "punctuation.separator.type.paneld"
        },
        "4": {
          "name": "support.type.paneld"
        }
      },
      "end": "(?=[;{}])|(?<!\\\\)(?=\\n)",
      "patterns": [
        {
          "begin": "=",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.assignment.paneld"
            }
          },
          "end": "(?=[;}])|(?<=[^\\s=][ \\t])(?=\\{(?!\\{))|(?<!\\\\)(?=\\n)",
          "patterns": [
            {
              "include": "#value-start"
            },
            {
              "include": "#value-inline"
            }
          ]
        },
        {
          "include": "#comment"
        }
      ]
    },
    "repeat": {
      "match": "\\b(repeat)\\s+([a-z_][a-z0-9_]*)\\s+(in)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.repeat.paneld"
        },
        "2": {
          "name": "variable.parameter.paneld"
        },
        "3": {
          "name": "keyword.control.in.paneld"
        }
      }
    },
    "block-header": {
      "match": "(?:^|(?<=[{;]))\\s*([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(?!in\\b)([A-Za-z_][A-Za-z0-9_.]*))?(?:\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*))?\\s*(?=\\{(?!\\{))",
      "captures": {
        "1": {
          "name": "entity.name.tag.paneld"
        },
        "2": {
          "name": "entity.name.function.paneld"
        },
        "3": {
          "name": "punctuation.separator.kind.paneld"
        },
        "4": {
          "name": "entity.name.type.paneld"
        }
      }
    },
    "assignment": {
      "begin": "(?:^|(?<=[{;]))\\s*(?:([A-Za-z_][A-Za-z0-9_]*)(\\[)([^\\]\\s]+)(\\])(:)|([A-Za-z_][A-Za-z0-9_]*)(:))?([A-Za-z_][A-Za-z0-9_-]*)\\s*(=)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.paneld"
        },
        "2": {
          "name": "punctuation.section.brackets.begin.paneld"
        },
        "3": {
          "name": "entity.name.function.paneld"
        },
        "4": {
          "name": "punctuation.section.brackets.end.paneld"
        },
        "5": {
          "name": "punctuation.separator.key.paneld"
        },
        "6": {
          "name": "entity.name.tag.paneld"
        },
        "7": {
          "name": "punctuation.separator.key.paneld"
        },
        "8": {
          "name": "variable.other.property.paneld"
        },
        "9": {
          "name": "keyword.operator.assignment.paneld"
        }
      },
      "end": "(?=[;}])|(?<!\\\\)(?=\\n)",
      "name": "meta.assignment.paneld",
      "patterns": [
        {
          "include": "#value-start"
        },
        {
          "include": "#value"
        }
      ]
    },
    "value": {
      "patterns": [
        {
          "include": "#value-inline"
        },
        {
          "include": "#value-comment"
        }
      ]
    },
    "value-inline": {
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#expression"
        },
        {
          "include": "#quoted"
        },
        {
          "include": "#single"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#value-comment"
        },
        {
          "include": "#literal"
        },
        {
          "include": "#inner-braces"
        }
      ]
    },
    "escape": {
      "patterns": [
        {
          "match": "\\\\\\\\|\\\\\\{\\{|\\\\$",
          "name": "constant.character.escape.paneld"
        },
        {
          "match": "##",
          "name": "constant.character.escape.paneld"
        },
        {
          "match": "\\$\\$",
          "name": "constant.character.escape.paneld"
        }
      ]
    },
    "value-comment": {
      "comment": "Inside a value, `#` starts a comment only between whitespace and whitespace or the line end; `2 #ff0000` and `Item #3` are text.",
      "match": "(?<=[ \\t])#(?=[ \\t]|$).*$",
      "name": "comment.line.number-sign.paneld"
    },
    "variable": {
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*",
      "name": "variable.other.constant.paneld"
    },
    "quoted": {
      "begin": "\"",
      "end": "\"|(?=\\n)",
      "name": "string.quoted.double.paneld",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.paneld"
        },
        {
          "include": "#expression"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "literal": {
      "patterns": [
        {
          "match": "(?<![\\w#])#(?:[0-9A-Fa-f]{8}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{3})\\b",
          "name": "constant.other.color.paneld"
        },
        {
          "match": "(?<![^\\s\\[,(])(?:\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)(?:ms|s|m|h|d|w|y|%|px|B|KiB|MiB|GiB|\\s+months?)?(?=$|[\\s\\],;})])",
          "name": "constant.numeric.paneld"
        },
        {
          "match": "(?<![^\\s\\[,(])(?:true|false|none|grow)(?=$|[\\s\\],;})])",
          "name": "constant.language.paneld"
        }
      ]
    },
    "inner-braces": {
      "begin": "\\{(?!\\{)",
      "end": "\\}",
      "patterns": [
        {
          "include": "#value-inline"
        }
      ]
    },
    "expression": {
      "begin": "\\{\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.paneld"
        }
      },
      "end": "\\}\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.paneld"
        }
      },
      "name": "meta.embedded.expression.cel.paneld",
      "patterns": [
        {
          "include": "#cel"
        }
      ]
    },
    "cel": {
      "patterns": [
        {
          "include": "#cel-string"
        },
        {
          "match": "\\b(?:0x[0-9A-Fa-f]+u?|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?u?)\\b",
          "name": "constant.numeric.cel"
        },
        {
          "match": "\\b(?:true|false|null)\\b",
          "name": "constant.language.cel"
        },
        {
          "match": "\\bin\\b",
          "name": "keyword.operator.in.cel"
        },
        {
          "match": "\\b(?:sources|vars|alerts|theme|now|secrets|page|nav|item|out|event|value|result|level|output|self)\\b(?!\\s*\\()",
          "name": "variable.language.cel"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.cel"
            }
          }
        },
        {
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.property.cel"
        },
        {
          "match": "&&|\\|\\||==|!=|<=|>=|[<>!?:+\\-*/%]",
          "name": "keyword.operator.cel"
        },
        {
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.constant.paneld"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "name": "meta.map.cel",
          "patterns": [
            {
              "include": "#cel"
            }
          ]
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#cel"
            }
          ]
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "#cel"
            }
          ]
        }
      ]
    },
    "cel-string": {
      "patterns": [
        {
          "begin": "[rR]?'''",
          "end": "'''",
          "name": "string.quoted.triple.cel"
        },
        {
          "begin": "[rR]?\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple.cel"
        },
        {
          "begin": "'",
          "end": "'|(?=\\n)",
          "name": "string.quoted.single.cel",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.cel"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"|(?=\\n)",
          "name": "string.quoted.double.cel",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.cel"
            }
          ]
        }
      ]
    },
    "value-start": {
      "comment": "A `#` at the start of a value is text (a color), not a comment.",
      "patterns": [
        {
          "match": "\\G[ \\t]*(#(?:[0-9A-Fa-f]{8}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{3}))(?![\\w])",
          "captures": {
            "1": {
              "name": "constant.other.color.paneld"
            }
          }
        },
        {
          "match": "\\G[ \\t]*#(?!#)[^\\s;}]*"
        }
      ]
    },
    "single": {
      "begin": "'",
      "end": "'|(?=\\n)",
      "name": "string.quoted.single.paneld",
      "patterns": [
        {
          "include": "#expression"
        },
        {
          "include": "#variable"
        },
        {
          "match": "\\$\\$",
          "name": "constant.character.escape.paneld"
        }
      ]
    },
    "style-header": {
      "match": "(?:^|(?<=[{;]))\\s*(style)\\s+([^{\\n]*?)\\s*(?=\\{)",
      "captures": {
        "1": {
          "name": "entity.name.tag.paneld"
        },
        "2": {
          "name": "entity.other.attribute-name.selector.paneld"
        }
      }
    }
  }
}
